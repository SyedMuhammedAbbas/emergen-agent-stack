# Copy to config.env and edit. config.env is git-ignored.
# Read by both the PowerShell and the WSL scripts: plain KEY=value lines, no quotes, no spaces around '='.

# ---- WSL ----
WSL_DISTRO=Ubuntu-24.04
# Linux user inside the distro
WSL_USER=
# VM memory cap written to %UserProfile%\.wslconfig (shared with Docker Desktop)
WSL_MEMORY=16GB

# ---- Paperclip ----
COMPANY_NAME=Emergen Engineering
COMPANY_DESCRIPTION=AI engineering org. Odoo is the client-facing source of truth; Paperclip issues are the agents' working copy.
# Manager timer heartbeat in seconds (0 disables)
MANAGER_HEARTBEAT_SEC=1800

# ---- Skills ----
# Folder (WSL path) holding the third-party skill folders listed in skills/THIRD_PARTY.md.
# Emergen's own skills are always taken from skills/ in this repo.
SKILLS_SOURCE=/mnt/c/Users/<windows-user>/agent-skills

# ---- Hermes bridge (Odoo <-> Paperclip <-> Discord) ----
# Discord channel for the digest, relayed questions and approvals
DISCORD_CHANNEL_ID=
# Odoo employee that approved agent hours are logged under
TIMESHEET_EMPLOYEE=
ODOO_READY_TAG=agent-ready
ODOO_SYNCED_TAG=agent-synced
INTAKE_SCHEDULE=every 15m
# Cron in the Windows local timezone
DIGEST_SCHEDULE=45 18 * * 1-6
