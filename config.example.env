# Copy to config.env and edit. config.env is git-ignored.
# Read by both the PowerShell and the WSL scripts: plain KEY=value lines, no quotes, no spaces around '='.
# A filled-in example lives in examples/emergen.env.

# ---- WSL ----
WSL_DISTRO=Ubuntu-24.04
# Linux user inside the distro
WSL_USER=
# VM memory cap written to %UserProfile%\.wslconfig (shared with Docker Desktop if you use it)
WSL_MEMORY=16GB

# ---- Your org ----
COMPANY_NAME=
COMPANY_DESCRIPTION=AI engineering org. The ticketing system is the client-facing source of truth; Paperclip issues are the agents' working copy.
# Default tech stack the agents and the Estimator assume unless a project says otherwise
STACK=Next.js, NestJS, PostgreSQL with TypeORM, React Native or Flutter
# Skill folder (in skills/ or SKILLS_SOURCE) holding your engineering standards and checklists.
# Replace skills/emergen-engineering with your own and put its folder name here.
ENGINEERING_SKILL=emergen-engineering
# Manager timer heartbeat in seconds (0 disables)
MANAGER_HEARTBEAT_SEC=1800

# ---- Skills ----
# WSL path of the folder holding third-party skill folders (skills/THIRD_PARTY.md).
# windows/collect-skills.ps1 fills it; this repo's skills/ always wins on a name clash.
SKILLS_SOURCE=/mnt/c/Users/<windows-user>/agent-skills

# ---- New projects (Estimator) ----
# WSL path under which project folders are created; /mnt/d/Projects is D:\Projects
PROJECTS_ROOT=/mnt/d/Projects
# Comma-separated sub-folders the Estimator asks you to choose from (e.g. Company,Personal or Clients,Internal)
PROJECT_CATEGORIES=Clients,Personal

# ---- Optional: Hermes bridge (Odoo + Discord). Skip with install.ps1 -SkipHermes ----
# Discord channel for the digest, relayed questions and approvals
DISCORD_CHANNEL_ID=
# Odoo employee that approved agent hours are logged under
TIMESHEET_EMPLOYEE=
ODOO_READY_TAG=agent-ready
INTAKE_SCHEDULE=every 15m
# Cron in the Windows local timezone
DIGEST_SCHEDULE=45 18 * * 1-6

# Optional per-purpose channels (blank = DISCORD_CHANNEL_ID)
DISCORD_APPROVALS_CHANNEL_ID=
DISCORD_QUESTIONS_CHANNEL_ID=
DISCORD_STANDUP_CHANNEL_ID=
DISCORD_ACTIVITY_CHANNEL_ID=
DISCORD_NEWPROJECT_CHANNEL_ID=

# ---- Daily routines ----
# Working days, Mon=0 ... Sun=6 (standup "Completed" uses the previous working day)
WORKDAYS=0,1,2,3,4,5
# Standup post (Hermes cron, local time) and its header, e.g. "DSM 18th Sept 2026" / your name
STANDUP_SCHEDULE=30 11 * * 1-6
STANDUP_TITLE=DSM
STANDUP_NAME=
# End-of-day timesheet proposal by the Timekeeper agent (Paperclip routine, local time)
TIMESHEET_SCHEDULE=30 18 * * 1-6
# Repos whose commits are never logged in Odoo (folder names, comma-separated)
TIMESHEET_EXCLUDE_REPOS=agent-stack
TIMEZONE=Asia/Karachi
# Your git author name or email, used to find your commits
GIT_AUTHOR=
# Hours to fill per working day
DAILY_HOURS=8

# ---- Disk guard: pause all agents below this many GB free on C: (WSL's disk lives there), resume above the second ----
DISK_MIN_FREE_GB=4
DISK_RESUME_FREE_GB=6

# Your own skills (in SKILLS_SOURCE) given to every agent, comma-separated, e.g. project context skills
EXTRA_SKILLS=
