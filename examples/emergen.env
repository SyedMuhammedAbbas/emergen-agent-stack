# Example: the configuration Emergen runs with (Odoo + Discord via Hermes, PKT timezone).
# Copy to ../config.env and adjust.

WSL_DISTRO=Ubuntu-24.04
WSL_USER=syedabbas
WSL_MEMORY=16GB

COMPANY_NAME=Emergen Engineering
COMPANY_DESCRIPTION=AI engineering org. Odoo is the client-facing source of truth; Paperclip issues are the agents' working copy.
STACK=Next.js, NestJS, PostgreSQL with TypeORM, React Native or Flutter
ENGINEERING_SKILL=emergen-engineering
MANAGER_HEARTBEAT_SEC=1800

SKILLS_SOURCE=/mnt/c/Users/syedabbas/agent-skills

PROJECTS_ROOT=/mnt/d/Projects
PROJECT_CATEGORIES=Emergen,Personal

DISCORD_CHANNEL_ID=1554551656333709382
TIMESHEET_EMPLOYEE=Syed Abbas
ODOO_READY_TAG=agent-ready
INTAKE_SCHEDULE=every 15m
DIGEST_SCHEDULE=45 18 * * 1-6
