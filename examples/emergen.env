# Example: the configuration Emergen runs with (Odoo + Discord via Hermes, PKT timezone).
# Copy to ../config.env and adjust.

WSL_DISTRO=Ubuntu-24.04
WSL_USER=syedabbas
WSL_MEMORY=16GB

COMPANY_NAME=Emergen Engineering
COMPANY_DESCRIPTION=AI engineering org. Odoo is the client-facing source of truth; Paperclip issues are the agents' working copy.
STACK=Next.js, NestJS, PostgreSQL with TypeORM, React Native or Flutter
ENGINEERING_SKILL=emergen-engineering
MANAGER_HEARTBEAT_SEC=1800

SKILLS_SOURCE=/mnt/c/Users/syedabbas/agent-skills

PROJECTS_ROOT=/mnt/d/Projects
PROJECT_CATEGORIES=Emergen,Personal

DISCORD_CHANNEL_ID=1554551656333709382
TIMESHEET_EMPLOYEE=Syed Abbas
ODOO_READY_TAG=agent-ready
INTAKE_SCHEDULE=every 15m
DIGEST_SCHEDULE=45 18 * * 1-6

# Optional per-purpose channels (blank = DISCORD_CHANNEL_ID)
DISCORD_APPROVALS_CHANNEL_ID=1554821658328702986
DISCORD_QUESTIONS_CHANNEL_ID=1554821704667111464
DISCORD_STANDUP_CHANNEL_ID=1554821789539110947
DISCORD_ACTIVITY_CHANNEL_ID=1554821846115942400
DISCORD_NEWPROJECT_CHANNEL_ID=1554821743833784380

# ---- Daily routines ----
# Working days, Mon=0 ... Sun=6 (standup "Completed" uses the previous working day)
WORKDAYS=0,1,2,3,4,5
# Standup post (Hermes cron, local time) and its header, e.g. "DSM 18th Sept 2026" / your name
STANDUP_SCHEDULE=30 11 * * 1-6
STANDUP_TITLE=Emergen DSM
STANDUP_NAME=Abbas
# End-of-day timesheet proposal by the Timekeeper agent (Paperclip routine, local time)
TIMESHEET_SCHEDULE=30 18 * * 1-6
TIMEZONE=Asia/Karachi
# Your git author name or email, used to find your commits
GIT_AUTHOR=Syed Mohammad Abbas
# Hours to fill per working day
DAILY_HOURS=8
