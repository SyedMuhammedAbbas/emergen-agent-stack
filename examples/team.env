# Emergen team template: company-wide values are filled in; the blanks are personal.
# cp examples/team.env config.env, then fill the blanks (CLAUDE.md and docs/team-setup.md explain each one).
# config.env is git-ignored: personal values and channel ids never go into the repo.

# ---- Machine (Windows + WSL only; ignored on macOS) ----
WSL_DISTRO=Ubuntu-24.04
WSL_USER=
# VM memory cap written to %UserProfile%\.wslconfig. 12GB is the tested value on a 32 GB laptop with Docker Desktop;
# below that, parallel agents can freeze WSL.
WSL_MEMORY=12GB

# ---- Company (shared; change only by agreement, in this file) ----
COMPANY_NAME=Emergen Engineering
COMPANY_DESCRIPTION=AI engineering org. Odoo is the client-facing source of truth; Paperclip issues are the agents' working copy.
STACK=Next.js, NestJS, PostgreSQL with TypeORM, React Native or Flutter
ENGINEERING_SKILL=emergen-engineering
MANAGER_HEARTBEAT_SEC=1800
DEPARTMENTS=engineering,operations
SKILLS_SOURCE=
# Project context skills every agent gets (project-skills/), comma-separated
EXTRA_SKILLS=neurax-context,prd-scope-discipline,khudmukhtaar-context

# ---- Your projects ----
# Root of your project folders: Windows+WSL e.g. /mnt/d/Projects, macOS e.g. /Users/<you>/Projects
PROJECTS_ROOT=
# Category folders under PROJECTS_ROOT; Personal is never logged to Odoo
PROJECT_CATEGORIES=Emergen,Personal
# The name or email on your commits (the Timekeeper finds your work with it)
GIT_AUTHOR=
TIMEZONE=Asia/Karachi
WORKDAYS=0,1,2,3,4
DAILY_HOURS=8
TIMESHEET_EXCLUDE_REPOS=agent-stack

# ---- Odoo + Discord bridge (Hermes); leave blank if you do not use it ----
# Your exact Odoo employee name (timesheets are logged against it)
TIMESHEET_EMPLOYEE=
ODOO_READY_TAG=agent-ready
# Your Discord channels (Developer Mode, right-click the channel, Copy Channel ID), or run windows/discord-channels.ps1
DISCORD_CHANNEL_ID=
DISCORD_APPROVALS_CHANNEL_ID=
DISCORD_QUESTIONS_CHANNEL_ID=
DISCORD_STANDUP_CHANNEL_ID=
DISCORD_ACTIVITY_CHANNEL_ID=
DISCORD_NEWPROJECT_CHANNEL_ID=
INTAKE_SCHEDULE=every 15m
DIGEST_SCHEDULE=45 18 * * 1-5
STANDUP_SCHEDULE=30 11 * * 1-5
STANDUP_TITLE=Emergen DSM
# Your name as it appears on the standup
STANDUP_NAME=
TIMESHEET_SCHEDULE=30 18 * * 1-5

# ---- Disk guard (pause agents below this many GB free on the system drive) ----
DISK_MIN_FREE_GB=4
DISK_RESUME_FREE_GB=6

# Watchdog agent stall sweep (Paperclip routine, local time); blank disables
WATCHDOG_SWEEP_SCHEDULE=0 */2 * * *
